PROJECT_ROOT=.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Секретный ключ в формате Base64 (минимум 256 бит для алгоритма HS256)
JWT_SECRET=
# Время жизни Access-токена (например, 15 минут в миллисекундах или формате Spring Duration: 15m)
JWT_EXPIRATION=
# Время жизни Refresh-токена (например, 7 дней в миллисекундах или 7d)
JWT_REFRESH_EXPIRATION=
